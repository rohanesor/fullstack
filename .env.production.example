# Never commit .env.production. Generate JWT_SECRET with: openssl rand -hex 48
POSTGRES_PASSWORD=replace-with-a-unique-long-password
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_HOST=complaints.example.edu
PUBLIC_ORIGIN=https://complaints.example.edu
JWT_MINUTES=480
MODEL_PATH=models/complaint_pipeline.joblib
MODEL_VERSION=unconfigured
